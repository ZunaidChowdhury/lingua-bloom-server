# Groq API key from the Groq console (required)
GROQ_API_KEY=
# Groq chat model id, e.g. llama-3.1-8b-instant (optional; has a default)
GROQ_MODEL=
# Supabase transaction pooler connection string, port 6543 (required)
DATABASE_URL=
# Exact frontend origin allowed by CORS
FRONTEND_ORIGIN=
# Log level: DEBUG, INFO, WARNING, or ERROR
LOG_LEVEL=
# Optional key for operational/admin endpoints
ADMIN_KEY=
# Hard LLM timeout in seconds
LLM_TIMEOUT_S=
# Counted attempts in the progression window
PROGRESS_WINDOW=
# Correct answers required inside the window to level up
PROGRESS_REQUIRED_CORRECT=
# Distinct skills that must be answered correctly for mastery
PROGRESS_MIN_DISTINCT_SKILLS=
# Misses on one item before a hint
HINT_AFTER_MISSES=
# Misses on one item before the answer is shown kindly
REVEAL_AFTER_MISSES=
# Consecutive Learning turns before a break
MAX_LEARNING_STREAK=
# Turns between feelings check-ins
CHECKIN_EVERY_N_TURNS=
# Recent messages sent to the LLM
CONTEXT_TURNS=
# Maximum child input length in characters
MAX_INPUT_CHARS=
# Maximum bot reply length in characters
MAX_REPLY_CHARS=
# Session expiry in days
SESSION_TTL_DAYS=
# asyncpg command timeout in seconds
DB_COMMAND_TIMEOUT_S=
# Optional test database connection string for integration tests
TEST_DATABASE_URL=
